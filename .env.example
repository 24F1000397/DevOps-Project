# CampusStock Environment Configuration Example

# Backend Database
DATABASE_URL=postgresql://campus_user:campus_password@postgres:5432/campusstock_db

# For local development without Docker:
# DATABASE_URL=postgresql://campus_user:campus_password@localhost:5432/campusstock_db

# Application Configuration
APP_NAME=CampusStock
APP_ENV=development
API_PREFIX=/api
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80
